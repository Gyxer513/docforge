# Шаблоны сопоставляются с путём целиком по правилам filepath.Match, и `*`
# не переходит через `/`. Поэтому там, где каталог может встретиться на любой
# глубине, нужен префикс `**/`: голое `__pycache__` поймало бы только корень,
# а нам важен как раз `src/**/__pycache__` — он попадает в образ вместе с
# `COPY src ./src`.

# Git и настройки CI
.git
.gitignore
.github

# Виртуальные окружения и кэши инструментов
.venv
venv
**/__pycache__
**/*.py[cod]
.mypy_cache
.ruff_cache
.pytest_cache

# Отчёты о покрытии
htmlcov
.coverage
coverage.xml

# Тесты и документация — в образ не копируются
tests
docs
*.md

# Артефакты генератора: сгенерированные при отладке .docx незачем
# передавать демону вместе с контекстом
**/*.docx

# Фронтенд — на будущее, чтобы node_modules не попал в контекст сразу
**/node_modules

# Локальные настройки и секреты. Образу они не нужны ни при каком раскладе,
# а `.env` тут ещё и подстраховка на случай, если в Dockerfile однажды
# появится `COPY . .`
.env
.env.*
.idea
.vscode
